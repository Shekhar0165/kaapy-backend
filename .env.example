GOOGLE_WEB_CLIENT_ID=504846525385-l27ph3fafr9vngog1cmjrk5ln2jhstc0.apps.googleusercontent.com
JWT_SECRET=
JWT_EXPIRES_IN=1d
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Kaapy <no-reply@relaysms.cloud>
REDIS_URL=redis://default:<password>@<host>:<port>
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
# Reverse geocoding for "Use my current location": google | nominatim | none (default none).
# With none the app can still read the location but the owner must type the address.
# nominatim (OpenStreetMap) needs no key; the server keeps it to 1 request per second.
GEOCODING_PROVIDER=nominatim
# Required only when GEOCODING_PROVIDER=google (server-side key; never put it in the app)
GEOCODING_API_KEY=
# Optional: NestJS Observe telemetry (https://observe.nestjs.com). Leave empty to turn it off.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
